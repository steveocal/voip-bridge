<?xml version="1.0"?>
<odoo>
    <record id="voip_call_bridge_list" model="ir.ui.view">
        <field name="name">voip.call.bridge.list</field>
        <field name="model">voip.call</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Calls" default_order="start_date desc">
                <field name="start_date"/>
                <field name="direction"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="state"/>
                <field name="voicemail" optional="show"/>
                <field name="duration" optional="show"/>
                <field name="bridge_did" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="recording" widget="audio_player" optional="show"/>
            </list>
        </field>
    </record>

    <record id="voip_call_bridge_form" model="ir.ui.view">
        <field name="name">voip.call.bridge.form</field>
        <field name="model">voip.call</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Call">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="voicemail"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration"/>
                            <field name="bridge_did"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="recording_filename" invisible="1"/>
                    <group string="Recording" invisible="not recording">
                        <field name="recording" widget="audio_player" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Transcript" name="transcript">
                            <field name="transcript" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="voip_call_bridge_search" model="ir.ui.view">
        <field name="name">voip.call.bridge.search</field>
        <field name="model">voip.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="transcript"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <separator/>
                <filter name="missed" string="Missed" domain="[('state', '=', 'missed')]"/>
                <filter name="voicemail" string="Voicemail" domain="[('voicemail', '=', True)]"/>
                <filter name="recorded" string="Recorded" domain="[('recording', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_voip_call_bridge" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">voip.call</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('voip_call_bridge_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('voip_call_bridge_form')})]"/>
        <field name="search_view_id" ref="voip_call_bridge_search"/>
    </record>

    <menuitem id="menu_voip_call_bridge"
        name="Calls"
        parent="contacts.menu_contacts"
        action="action_voip_call_bridge"
        sequence="5"/>
</odoo>
