<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Toggle button in the form view's control panel, in the navigation area
        after the record pager (right-justified, it does not move when the
        chatter is shown or hidden). Only on forms whose arch has a chatter.
    -->
    <t t-name="web.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button t-if="hasChatterToggle" type="button"
                        class="o_chatter_toggle btn btn-secondary"
                        t-att-class="{ active: !chatterToggleHidden }"
                        t-att-title="chatterToggleTitle"
                        t-att-aria-label="chatterToggleTitle"
                        t-on-click="onClickToggleChatter">
                    <i class="fa" t-att-class="chatterToggleHidden ? 'fa-comments-o' : 'fa-comments'"/>
                </button>
            </t>
        </xpath>
    </t>

    <!-- Flag the chatter root while hidden; chatter_toggle.scss does the rest. -->
    <t t-name="mail.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="attributes">
            <attribute name="t-att-data-chatter-hidden">chatterToggleHidden ? '1' : false</attribute>
        </xpath>
    </t>

</templates>
