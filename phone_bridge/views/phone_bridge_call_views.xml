<?xml version="1.0"?>
<odoo>
    <record id="phone_bridge_call_list" model="ir.ui.view">
        <field name="name">phone_bridge.call.list</field>
        <field name="model">phone_bridge.call</field>
        <field name="arch" type="xml">
            <list string="Calls" create="false" decoration-danger="state == 'missed' and not voicemail" decoration-muted="state in ('aborted', 'rejected')"
                  decoration-bf="voicemail and not voicemail_heard">
                <field name="voicemail_heard" column_invisible="1"/>
                <field name="start_date"/>
                <field name="extension" optional="show"/>
                <field name="direction"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="state"/>
                <field name="voicemail" optional="show"/>
                <field name="voicemail_box" optional="hide"/>
                <field name="duration" optional="show"/>
                <field name="did" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="recording_filename" column_invisible="1"/>
                <field name="recording" widget="phone_bridge_audio" optional="show"/>
            </list>
        </field>
    </record>

    <record id="phone_bridge_call_form" model="ir.ui.view">
        <field name="name">phone_bridge.call.form</field>
        <field name="model">phone_bridge.call</field>
        <field name="arch" type="xml">
            <form string="Call" create="false">
                <header>
                    <button name="action_mark_heard" type="object" string="Mark as heard" class="btn-primary"
                            invisible="not voicemail or voicemail_heard"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number" widget="phone"/>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="voicemail"/>
                            <field name="voicemail_box" invisible="not voicemail"/>
                            <field name="voicemail_extension_id" invisible="not voicemail_extension_id"/>
                            <field name="voicemail_heard" invisible="not voicemail"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration"/>
                            <field name="did"/>
                            <field name="extension"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="recording_filename" invisible="1"/>
                    <group string="Recording" invisible="not recording">
                        <field name="recording" widget="phone_bridge_audio" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Transcript" name="transcript" invisible="not transcript">
                            <field name="transcript" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="phone_bridge_call_search" model="ir.ui.view">
        <field name="name">phone_bridge.call.search</field>
        <field name="model">phone_bridge.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="transcript"/>
                <field name="extension"/>
                <field name="user_id"/>
                <filter name="my_calls" string="My calls" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <separator/>
                <filter name="missed" string="Missed" domain="[('state', '=', 'missed')]"/>
                <filter name="voicemail" string="Voicemail" domain="[('voicemail', '=', True)]"/>
                <filter name="unheard" string="Unheard voicemail" domain="[('voicemail', '=', True), ('voicemail_heard', '=', False)]"/>
                <filter name="recorded" string="Recorded" domain="[('recording', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_extension" string="Extension" context="{'group_by': 'extension'}"/>
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_box" string="Mailbox" context="{'group_by': 'voicemail_box'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_phone_bridge_call" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">phone_bridge.call</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="phone_bridge_call_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calls yet</p>
            <p>Calls appear here as your phone system handles them.</p>
        </field>
    </record>
</odoo>
