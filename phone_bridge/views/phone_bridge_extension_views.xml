<?xml version="1.0"?>
<odoo>
    <record id="phone_bridge_extension_list" model="ir.ui.view">
        <field name="name">phone_bridge.extension.list</field>
        <field name="model">phone_bridge.extension</field>
        <field name="arch" type="xml">
            <list string="Extensions">
                <field name="number"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="user_share" optional="hide"/>
                <field name="voicemail_enabled"/>
                <field name="greeting_filename" string="Greeting" optional="show"/>
                <field name="voicemail_email" optional="show"/>
            </list>
        </field>
    </record>

    <record id="phone_bridge_extension_form" model="ir.ui.view">
        <field name="name">phone_bridge.extension.form</field>
        <field name="model">phone_bridge.extension</field>
        <field name="arch" type="xml">
            <form string="Extension">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="number" placeholder="201"/></h1>
                        <field name="name" placeholder="e.g. Desk phone"/>
                    </div>
                    <group>
                        <group string="Extension">
                            <field name="user_id"/>
                            <field name="user_share" invisible="1"/>
                            <div colspan="2" class="text-muted" invisible="not user_share">
                                A portal or public user signs in with the phone app or dashboard only:
                                no softphone in Odoo, and voicemail comes by email without a to-do.
                            </div>
                            <field name="sip_password" password="True"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Voicemail">
                            <field name="voicemail_enabled"/>
                            <field name="greeting_filename" invisible="1"/>
                            <field name="greeting" filename="greeting_filename" invisible="not voicemail_enabled"/>
                            <field name="greeting" widget="phone_bridge_audio" string="Listen" invisible="not voicemail_enabled or not greeting"/>
                            <field name="voicemail_email" invisible="not voicemail_enabled"/>
                            <div colspan="2" class="text-muted" invisible="voicemail_enabled">
                                Callers who aren't answered hear a busy tone.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_phone_bridge_extension" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">phone_bridge.extension</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your phone system's extensions</p>
            <p>Each extension gets its own voicemail box, greeting and email address.</p>
        </field>
    </record>
</odoo>
