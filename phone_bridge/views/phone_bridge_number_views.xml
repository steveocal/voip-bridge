<?xml version="1.0"?>
<odoo>
    <record id="phone_bridge_number_list" model="ir.ui.view">
        <field name="name">phone_bridge.number.list</field>
        <field name="model">phone_bridge.number</field>
        <field name="arch" type="xml">
            <list string="Phone Numbers">
                <field name="number"/>
                <field name="name"/>
                <field name="extension_ids" widget="many2many_tags"/>
                <field name="ring_mobiles" optional="show"/>
                <field name="ring_seconds" optional="hide"/>
                <field name="answer" optional="show"/>
                <field name="calendar_id" optional="show"/>
                <field name="no_answer"/>
                <field name="record" optional="show"/>
            </list>
        </field>
    </record>

    <record id="phone_bridge_number_form" model="ir.ui.view">
        <field name="name">phone_bridge.number.form</field>
        <field name="model">phone_bridge.number</field>
        <field name="arch" type="xml">
            <form string="Phone Number">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="number" placeholder="+44 1283 246490"/></h1>
                        <field name="name" placeholder="e.g. Sales"/>
                    </div>
                    <group>
                        <group string="Who Answers">
                            <field name="answer"/>
                            <field name="menu_id" invisible="answer != 'menu'" required="answer == 'menu'"/>
                            <field name="extension_ids" widget="many2many_tags" options="{'no_create': True}"
                                   invisible="answer != 'ring'"/>
                            <field name="ring_mobiles" invisible="answer != 'ring'"/>
                            <field name="ring_seconds" invisible="answer != 'ring'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="When Nobody Answers">
                            <field name="no_answer"/>
                            <field name="no_answer_number" invisible="no_answer != 'forward'"
                                   required="no_answer == 'forward'" placeholder="+44 7700 900123"/>
                            <field name="record"/>
                        </group>
                        <group string="Opening Hours">
                            <field name="calendar_id"/>
                            <field name="closed_action" invisible="not calendar_id"/>
                            <field name="closed_number" invisible="not calendar_id or closed_action != 'forward'"
                                   required="calendar_id and closed_action == 'forward'" placeholder="+44 7700 900123"/>
                            <field name="closed_menu_id" invisible="not calendar_id or closed_action != 'menu'"
                                   required="calendar_id and closed_action == 'menu'"/>
                            <field name="closed_message" invisible="not calendar_id"
                                   placeholder="We're closed at the moment. Our hours are 9 till 5, Monday to Friday."/>
                            <field name="voice" invisible="not calendar_id or not closed_message"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The extensions ring together. A user's mobile (set on the user) joins after their own delay,
                        and the dashboard's 📼 / 📱 switches take a user's extensions out, or bring their mobile in
                        straight away.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_phone_bridge_number" model="ir.actions.act_window">
        <field name="name">Phone Numbers</field>
        <field name="res_model">phone_bridge.number</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the numbers your callers ring</p>
            <p>For each one, choose which extensions ring and what happens when nobody answers. The phone
               system routes the calls from here; a number not set up here keeps the phone system's own routing.</p>
        </field>
    </record>
</odoo>
