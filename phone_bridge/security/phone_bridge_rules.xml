<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A call is its user's: the one whose extension made or answered it.
         Calls nobody answered (no user) are everyone's. Administrators see
         all calls in the backend; the phone panel still shows only theirs. -->
    <record id="rule_phone_bridge_call_own" model="ir.rule">
        <field name="name">Phone calls: own and unanswered</field>
        <field name="model_id" ref="model_phone_bridge_call"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_phone_bridge_call_admin" model="ir.rule">
        <field name="name">Phone calls: administrators see all</field>
        <field name="model_id" ref="model_phone_bridge_call"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
